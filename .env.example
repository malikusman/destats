# Optional Vite overrides for local `npm run dev`.
# Docker Compose does not require a .env — see docker-compose.yml defaults.

# Base URL for the scorpius-netapp-ingestion-api.
# Defaults to /api-proxy (Vite → http://10.0.65.40:8080; Nginx uses API_TARGET).
VITE_API_BASE_URL=/api-proxy

# Browser path for the platform API (proxied by Vite/Nginx to the real backend).
# Default upstream: http://10.0.65.19:8088/incident-api
# Deferred direct service: http://10.0.65.19:8003
VITE_INCIDENT_API_BASE_URL=/incident-api

# Browser path for Control Plane (AI / Agent / Policy / Execution).
# Upstream: http://10.0.65.40:8000 (not .19:8000 — that host is Attu).
VITE_CONTROL_PLANE_API_BASE_URL=/control-plane-api

# Set to 1 to enable demo INC-* incidents and mock AI workflow (offline dev only).
# VITE_USE_MOCK_INCIDENTS=1

# Set to 1 to force mock knowledge data instead of the live knowledge API.
# VITE_USE_MOCK_KNOWLEDGE=1

# Vite dev proxy override for incident API upstream (optional).
# INCIDENT_API_TARGET=http://10.0.65.19:8088/incident-api

# Vite / Docker override for Control Plane upstream (optional).
# CONTROL_PLANE_API_TARGET=http://10.0.65.40:8000
